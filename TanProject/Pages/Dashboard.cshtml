@page
@model TanProject.Pages.DashboardModel
@{
    ViewData["Title"] = "تَن من";
    ViewData["BodyClass"] = "page-welcome";
    ViewData["TranslationKey"] = "dashboard.title";
}
@section Decoration {
    <div class="decoration">
        <div class="decoration__shapes">
            <div class="decoration__shape decoration__shape--yellow decoration__shape--hero-primary"></div>
            <div class="decoration__shape decoration__shape--green decoration__shape--welcome-secondary"></div>
            <div class="decoration__shape decoration__shape--purple decoration__shape--welcome-tertiary"></div>
        </div>
        <div class="decoration__chat-wrapper">
            <svg class="decoration__chat-top-left" xmlns="http://www.w3.org/2000/svg" width="213" height="239"
                 viewBox="0 0 213 239" fill="none">
                <path d="M180.118 131.58C266.314 0.235305 161.321 -9.30682 105.941 4.90087C-20.5709 37.358 -3.10526 119.32 7.03548 177.506C17.1762 235.692 72.3732 295.762 180.118 131.58Z"
                      fill="url(#paint0_linear_146_458)" fill-opacity="0.7" />
                <defs>
                    <linearGradient id="paint0_linear_146_458" x1="188.29" y1="5.80631" x2="3.1121" y2="200.108"
                                    gradientUnits="userSpaceOnUse">
                        <stop offset="0.485577" stop-color="#70A0AF" />
                        <stop offset="1" stop-color="#2F4349" />
                    </linearGradient>
                </defs>
            </svg>
            <svg class="decoration__chat-top-right" xmlns="http://www.w3.org/2000/svg" width="210" height="246"
                 viewBox="0 0 210 246" fill="none">
                <path d="M134.908 24.9769C31.7925 -46.4592 10.1468 51.7639 0.8579 114.272C-10.5143 190.799 93.662 292.862 165.842 222.257C221.402 167.91 238.023 96.4129 134.908 24.9769Z"
                      fill="url(#paint0_linear_146_459)" fill-opacity="0.7" />
                <defs>
                    <linearGradient id="paint0_linear_146_459" x1="105" y1="0" x2="105" y2="246"
                                    gradientUnits="userSpaceOnUse">
                        <stop offset="0.634615" stop-color="#A0C1B9" />
                        <stop offset="1" stop-color="#4B5B57" />
                    </linearGradient>
                </defs>
            </svg>
            <svg class="decoration__chat-bottom-left" xmlns="http://www.w3.org/2000/svg" width="256" height="251"
                 viewBox="0 0 256 251" fill="none">
                <path d="M72.8391 1.80419C-72.7609 -16.9958 47.1094 115.652 34.3391 189.304C12.8391 313.304 219.339 212.804 245.839 189.304C272.339 165.804 254.839 25.3042 72.8391 1.80419Z"
                      fill="url(#paint0_linear_146_457)" fill-opacity="0.7" />
                <defs>
                    <linearGradient id="paint0_linear_146_457" x1="127.838" y1="0" x2="127.838" y2="250.019"
                                    gradientUnits="userSpaceOnUse">
                        <stop offset="0.6875" stop-color="#A0C1B9" />
                        <stop offset="1" stop-color="#4B5B57" />
                    </linearGradient>
                </defs>
            </svg>
            <svg class="decoration__chat-bottom-right" xmlns="http://www.w3.org/2000/svg" width="285" height="284"
                 viewBox="0 0 285 284" fill="none">
                <path d="M227.286 244.743C324.745 171.264 281.011 65.1061 213.313 8.85423C174.472 -23.4197 110.187 36.7574 86.9725 121.003C73.6543 169.334 34.6543 160.334 18.4585 175.834C-54.7852 245.931 105.462 336.591 227.286 244.743Z"
                      fill="url(#paint0_linear_146_456)" fill-opacity="0.7" />
                <defs>
                    <linearGradient id="paint0_linear_146_456" x1="257.976" y1="45.9651" x2="16.1573" y2="336.991"
                                    gradientUnits="userSpaceOnUse">
                        <stop offset="0.596154" stop-color="#F4E8C1" />
                        <stop offset="1" stop-color="#8E8770" />
                    </linearGradient>
                </defs>
            </svg>
        </div>
    </div>
}
<main class="main">
    <div class="container">
        <div class="dashboard d-flex">
            <aside class="profile-card d-flex flex-column justify-between align-center">
                <div class="profile-card__wrapper d-flex flex-column align-center">
                    <div class="profile-card__avatar">
                        <img src="~/images/avatar.jpeg" data-i18n-attr="alt:dashboard.profileImageAlt">
                    </div>
                    <div class="profile-card__info d-flex flex-column align-center">
                        <h2 class="profile-card__name"></h2>
                        <p class="profile-card__badge">
                            <span class="accent" id="user-day-count"></span>
                            <span data-i18n="dashboard.presenceText"></span>
                        </p>
                    </div>
                </div>
                <div class="profile-card__actions d-flex flex-column">
                    <button type="button" class="btn btn--outline" data-i18n="dashboard.editName"></button>
                    <button type="button" class="btn btn--danger-outline" id="deleteAllDataBtn" data-i18n="dashboard.deleteAllData"></button>
                </div>
            </aside>
            <section class="gallery-card d-flex flex-column align-center">
                <h1 class="gallery-card__title" data-i18n="dashboard.galleryTitle"></h1>
                <div class="gallery-card__grid d-flex justify-center">
                </div>
                <p class="gallery-card__note" data-i18n="dashboard.privacyNote"></p>
            </section>
        </div>
    </div>
</main>

@section Scripts {
    <script src="./js/tanDayCount.js"></script>
    <script src="./js/dashboard.js"></script>
}