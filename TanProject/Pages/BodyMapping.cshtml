@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<TanProject.Pages.BodyMappingModel> Localizer
@model TanProject.Pages.BodyMappingModel
@{
    ViewData["Title"] = "گام دوم";
    ViewData["HeaderType"] = "Secondary";
    ViewData["BodyClass"] = "page-welcome";
    ViewData["TranslationKey"] = "bodyMapping.title";
}
@section Decoration{
