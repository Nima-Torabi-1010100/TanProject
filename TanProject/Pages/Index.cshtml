@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<TanProject.Pages.BodyMappingModel> Localizer
@model TanProject.Pages.IndexModel
@{
    ViewData["Title"] = "خانه";
    ViewData["ActivePage"] = "Index";
    ViewData["TranslationKey"] = "homePage.title";
}
@section Decoration {
    <div class="decoration">
        <div class="decoration__shape decoration__shape--yellow decoration__shape--hero-primary"></div>
        <div class="decoration__shape decoration__shape--purple decoration__shape--hero-secondary"></div>
        <div class="decoration__img decoration__img--top">
            <img src="/images/decor-ball-filtered.webp" alt="decor-ball.webp">
        </div>
        <div class="decoration__img decoration__img--center">
            <img src="/images/decor-ball-filtered.webp" alt="decor-ball.webp">
        </div>
        <div class="decoration__img decoration__img--bottom">
            <img src="/images/decor-ball-filtered.webp" alt="decor-ball.webp">
        </div>
    </div>
}
<main class="hero">
    <div class="container">
        <div class="row align-center flex-column-reverse">
            <div class="col-7 col-tablet-12  col-mobile-12">
                <div class="hero__content d-flex flex-column align-start">
                    <h1 class="hero__title">
                        <span data-i18n="hero.titlePart1">@Localizer["hero.titlePart1"]</span>
                        <span class="accent" data-i18n="hero.titleAccent">@Localizer["hero.titleAccent"]</span>
                        <span data-i18n="hero.titlePart2">@Localizer["hero.titlePart2"]</span>
                    </h1>
                    <p class="hero__subtitle" data-i18n="hero.subtitle">@Localizer["hero.subtitle"]</p>
                    <a asp-page="Welcome" class="btn hero__cta" data-i18n="hero.cta">@Localizer["hero.cta"]</a>
                </div>
            </div>
            <div class="col-5 col-tablet-12  col-mobile-12">
                <div class="hero__img">
                    <img src="./images/breathing-ball.png" alt="breathing-ball.png">
                </div>
            </div>
        </div>
    </div>
</main>
@section Scripts {
    <script src="./js/tanDayCount.js"></script>
}