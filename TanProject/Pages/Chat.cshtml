@page
@model TanProject.Pages.ChatModel
@{
    ViewData["Title"] = "گام سوم";
    ViewData["HeaderType"] = "Secondary";
    ViewData["BodyClass"] = "page-welcome";
    ViewData["TranslationKey"] = "chat.title";
}
@section Decoration {
    <div class="decoration">
        <div class="decoration__shapes">
            <div class="decoration__shape decoration__shape--yellow decoration__shape--hero-primary"></div>
            <div class="decoration__shape decoration__shape--green decoration__shape--welcome-secondary"></div>
            <div class="decoration__shape decoration__shape--purple decoration__shape--welcome-tertiary"></div>
        </div>
        <div class="decoration__chat-wrapper">
            <svg class="decoration__chat-top-left" xmlns="http://www.w3.org/2000/svg" width="213" height="239"
                 viewBox="0 0 213 239" fill="none">
                <path d="M180.118 131.58C266.314 0.235305 161.321 -9.30682 105.941 4.90087C-20.5709 37.358 -3.10526 119.32 7.03548 177.506C17.1762 235.692 72.3732 295.762 180.118 131.58Z"
                      fill="url(#paint0_linear_146_458)" fill-opacity="0.7" />
                <defs>
                    <linearGradient id="paint0_linear_146_458" x1="188.29" y1="5.80631" x2="3.1121" y2="200.108"
                                    gradientUnits="userSpaceOnUse">
                        <stop offset="0.485577" stop-color="#70A0AF" />
                        <stop offset="1" stop-color="#2F4349" />
                    </linearGradient>
                </defs>
            </svg>
            <svg class="decoration__chat-top-right" xmlns="http://www.w3.org/2000/svg" width="210" height="246"
                 viewBox="0 0 210 246" fill="none">
                <path d="M134.908 24.9769C31.7925 -46.4592 10.1468 51.7639 0.8579 114.272C-10.5143 190.799 93.662 292.862 165.842 222.257C221.402 167.91 238.023 96.4129 134.908 24.9769Z"
                      fill="url(#paint0_linear_146_459)" fill-opacity="0.7" />
                <defs>
                    <linearGradient id="paint0_linear_146_459" x1="105" y1="0" x2="105" y2="246"
                                    gradientUnits="userSpaceOnUse">
                        <stop offset="0.634615" stop-color="#A0C1B9" />
                        <stop offset="1" stop-color="#4B5B57" />
                    </linearGradient>
                </defs>
            </svg>
            <svg class="decoration__chat-bottom-left" xmlns="http://www.w3.org/2000/svg" width="256" height="251"
                 viewBox="0 0 256 251" fill="none">
                <path d="M72.8391 1.80419C-72.7609 -16.9958 47.1094 115.652 34.3391 189.304C12.8391 313.304 219.339 212.804 245.839 189.304C272.339 165.804 254.839 25.3042 72.8391 1.80419Z"
                      fill="url(#paint0_linear_146_457)" fill-opacity="0.7" />
                <defs>
                    <linearGradient id="paint0_linear_146_457" x1="127.838" y1="0" x2="127.838" y2="250.019"
                                    gradientUnits="userSpaceOnUse">
                        <stop offset="0.6875" stop-color="#A0C1B9" />
                        <stop offset="1" stop-color="#4B5B57" />
                    </linearGradient>
                </defs>
            </svg>
            <svg class="decoration__chat-bottom-right" xmlns="http://www.w3.org/2000/svg" width="285" height="284"
                 viewBox="0 0 285 284" fill="none">
                <path d="M227.286 244.743C324.745 171.264 281.011 65.1061 213.313 8.85423C174.472 -23.4197 110.187 36.7574 86.9725 121.003C73.6543 169.334 34.6543 160.334 18.4585 175.834C-54.7852 245.931 105.462 336.591 227.286 244.743Z"
                      fill="url(#paint0_linear_146_456)" fill-opacity="0.7" />
                <defs>
                    <linearGradient id="paint0_linear_146_456" x1="257.976" y1="45.9651" x2="16.1573" y2="336.991"
                                    gradientUnits="userSpaceOnUse">
                        <stop offset="0.596154" stop-color="#F4E8C1" />
                        <stop offset="1" stop-color="#8E8770" />
                    </linearGradient>
                </defs>
            </svg>
        </div>
    </div>
}
<main class="main">
    <div class="container">
        <div class="chat d-flex flex-column align-center" id="tan-chat">
            <div class="chat__header d-flex justify-center align-center">
                <h2 class="chat__title">
                    <span data-i18n="chat.headerTitle"></span>
                    <span data-i18n="chat.headerAccent" class="accent"></span>
                </h2>
            </div>

            <template id="chat-avatar-template">
                <div class="chat__avatar d-flex justify-center align-center">
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                         id="Layer_1" width="326.6054mm" height="326.6054mm" viewBox="0 0 925.8107 925.8107">
                        <defs>
                            <linearGradient id="linear-gradient" x1="42.6723" y1="454.2908" x2="883.1384"
                                            y2="454.2908" gradientUnits="userSpaceOnUse">
                                <stop offset="0" stop-color="#a0c1b9" />
                                <stop offset="1" stop-color="#706993" />
                            </linearGradient>
                        </defs>
                        <path d="M640.5545,188.0261c86.5383,0,140.6246,93.68,97.3555,168.6242l-177.6492,307.6974c-21.6346,37.4721-59.495,56.2081-97.3555,56.2081s-75.7208-18.736-97.3555-56.2081l-177.6492-307.6974c-43.2692-74.9442,10.8175-168.6242,97.3555-168.6242h355.2983M640.5545,58.0261h-355.2983c-44.1934,0-87.3358,11.8883-124.7642,34.3796-35.1055,21.0954-64.5583,51.1204-85.1746,86.8287-20.6163,35.7083-31.8921,76.2279-32.6088,117.1775-.7638,43.6592,10.5121,86.9662,32.6088,125.2383l177.6492,307.6974c22.0967,38.2725,53.9637,69.6913,92.1558,90.8593,35.8217,19.8541,76.5504,30.3486,117.783,30.3486s81.9613-10.4945,117.783-30.3486c38.192-21.168,70.0591-52.5867,92.1558-90.8593l177.6493-307.6974c22.0967-38.2721,33.3723-81.5788,32.6086-125.2383-.7166-40.95-11.9924-81.4692-32.6086-117.1775-20.6165-35.7087-50.0692-65.7333-85.1747-86.8287-37.4283-22.4913-80.5708-34.3796-124.7642-34.3796h0Z"
                              fill="url(#linear-gradient)" stroke-width="0" />
                    </svg>
                </div>
            </template>

            <div class="chat__body d-flex flex-column" id="chat-messages" role="log" aria-live="polite">
                <div class="chat__message chat__message--ai d-flex" data-role="assistant">
                    <div class="chat__avatar d-flex justify-center align-center">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                             id="Layer_1" width="326.6054mm" height="326.6054mm" viewBox="0 0 925.8107 925.8107">
                            <defs>
                                <linearGradient id="linear-gradient" x1="42.6723" y1="454.2908" x2="883.1384"
                                                y2="454.2908" gradientUnits="userSpaceOnUse">
                                    <stop offset="0" stop-color="#a0c1b9" />
                                    <stop offset="1" stop-color="#706993" />
                                </linearGradient>
                            </defs>
                            <path d="M640.5545,188.0261c86.5383,0,140.6246,93.68,97.3555,168.6242l-177.6492,307.6974c-21.6346,37.4721-59.495,56.2081-97.3555,56.2081s-75.7208-18.736-97.3555-56.2081l-177.6492-307.6974c-43.2692-74.9442,10.8175-168.6242,97.3555-168.6242h355.2983M640.5545,58.0261h-355.2983c-44.1934,0-87.3358,11.8883-124.7642,34.3796-35.1055,21.0954-64.5583,51.1204-85.1746,86.8287-20.6163,35.7083-31.8921,76.2279-32.6088,117.1775-.7638,43.6592,10.5121,86.9662,32.6088,125.2383l177.6492,307.6974c22.0967,38.2725,53.9637,69.6913,92.1558,90.8593,35.8217,19.8541,76.5504,30.3486,117.783,30.3486s81.9613-10.4945,117.783-30.3486c38.192-21.168,70.0591-52.5867,92.1558-90.8593l177.6493-307.6974c22.0967-38.2721,33.3723-81.5788,32.6086-125.2383-.7166-40.95-11.9924-81.4692-32.6086-117.1775-20.6165-35.7087-50.0692-65.7333-85.1747-86.8287-37.4283-22.4913-80.5708-34.3796-124.7642-34.3796h0Z"
                                  fill="url(#linear-gradient)" stroke-width="0" />
                        </svg>
                    </div>
                    <div class="chat__bubble">
                        <span>سلام </span>
                        <span class="accent" id="user-name"></span>
                        <span>! کمی صبور باش اطلاعاتت رو بررسی کنم و گفت‌وگو رو آغاز بکنیم.</span>
                    </div>
                </div>
            </div>

            <form class="chat__input-area d-flex align-center" id="chat-form">
                @Html.AntiForgeryToken()
                <input type="text"
                       class="chat__input"
                       id="chat-input"
                       data-i18n-attr="placeholder:chat.inputPlaceholder"
                       autocomplete="off"
                       dir="rtl" />
                <button type="submit" class="btn chat__send-btn"
                        id="chat-send"
                        data-i18n-aria-label="chat.sendButtonLabel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28" fill="none">
                        <path d="M25.5741 13.537H1.5" stroke="white" stroke-width="3" stroke-linecap="round"
                              stroke-linejoin="round" />
                        <path d="M13.537 25.5741L1.5 13.537L13.537 1.5" stroke="white" stroke-width="3"
                              stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </form>
        </div>
        <button class="btn btn--secondary chat__finish-btn" type="button" data-i18n="chat.finishConversation"></button>
    </div>
</main>
@section Footer {
    <footer class="footer">
        <div class="pagination">
            <div class="dot-wrapper">
                <span class="dot dot--active"></span>
            </div>
            <div class="dot-wrapper">
                <span class="dot dot--active"></span>
            </div>
            <div class="dot-wrapper">
                <span class="dot dot--active"></span>
            </div>
            <div class="dot-wrapper">
                <span class="dot"></span>
            </div>
        </div>
        <span class="footer__text">گام سوم: گفت‌وگوی تن‌آگاه</span>
    </footer>
}
@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}