        <div class="reflection-share-card__content">
            <img id="share-card-image" class="reflection-share-card__image" src="" alt="">
            <div id="share-card-narrative" class="reflection-share-card__narrative"></div>
            <div class="reflection-share-card__footer">
                ساخته‌شده توسط تَن
